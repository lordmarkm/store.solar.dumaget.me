# Local process only: no Firebase connection or credentials needed for health/tests.
NODE_ENV=development
HOST=127.0.0.1
PORT=4400
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:4300,http://localhost:4300
FIREBASE_PROJECT_ID=dumaget-me-solar
FIRESTORE_DATABASE_ID=store-dev
FIREBASE_BACKEND_ENABLED=false
# Leave false until Auth recovery/provider verification is separately approved.
FIREBASE_AUTH_SETUP_APPROVED=false
# Server-controlled eligibility policy; matching email is NOT an admin grant.
ADMIN_EMAIL_DOMAINS=solar.dumaget.me
# After approved activation only, use ADC via GOOGLE_APPLICATION_CREDENTIALS.
# Do not paste service-account JSON, tokens or private keys into this file.
# Emulator connections are not implemented in this bootstrap.
