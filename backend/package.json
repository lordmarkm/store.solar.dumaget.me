{
  "name": "solar-store-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "tsc -p tsconfig.check.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:builder": "node --import tsx --test test/builder-rules.test.ts test/builder-rule-documentation.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "firebase-admin": "14.5.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
